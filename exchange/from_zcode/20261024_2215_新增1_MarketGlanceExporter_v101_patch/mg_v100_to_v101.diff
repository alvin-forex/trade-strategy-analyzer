+//--- P1-1: 多候選鏈解析："A|B|C" 逐個試，首中即用；全滅回 ""
+string ResolveFirst(const string candidates)
+{
+   string parts[];
+   int n = StringSplit(candidates, '|', parts);
+   if(n <= 0)
+      return "";
+   for(int i = 0; i < n; i++)
+   {
+      string one = parts[i];
+      // 清空格
+      StringTrimLeft(one);
+      StringTrimRight(one);
+      if(StringLen(one) == 0)
+         continue;
+      string hit = ResolveSym(one);
+      if(hit != "")
+         return hit;
+   }
+   return "";
+}
