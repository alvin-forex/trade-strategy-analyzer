+//================= v1.54 FIX-TD4: BINGO CLOSE BOARD (0745 放行信) =========
+// 覆蓋 0745 信全部硬約束：
+//   - 品種來源只准即時掃 OrdersTotal()，禁 g_ddSyms[]（跨帳戶幽靈 SYMBOL）
+//   - 平倉只准 OrderSelect(SELECT_BY_POS, MODE_TRADES) 即時重掃，禁 t_ 陣列
+//   - ARM 60s 倒數未 ARM 全板禁用灰；到期自動失效；切 TAB／帳號變更解除
+//   - 每按鈕獨立 30s 冷卻；橙紅色；即按即執行無延遲；殘留顯示 RESID n
+//   - 底部 LAST 行；[CLOSE 全倉] 含刪除全部 pending
+string BINGO_BtnName(int b)
+{
+   if(b == 0) return("BUY");
+   if(b == 1) return("SELL");
+   if(b == 2) return("WIN");
+   if(b == 3) return("LOSE");
+   return("ALL");
+}
+
+//--- rows per page from live chart height (0745: 高度自適應 + 分頁唔跌出圖底)
+int BINGO_RowsPerPage(int boardTopY)
+{
+   int ch = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS, 0);
+   int avail = ch - 30 - boardTopY - 18 - 18 - 10;
+   int n = avail / 15;
+   if(n < 3)  n = 3;
+   if(n > 28) n = 28;
+   return(n);
+}
+
+//--- live scan of OrdersTotal(): symbol / position count / lots / float P&L
+//--- sorted worst floating loss on top (tie: more positions first)
+int BINGO_Collect(string &syms[], int &cnt[], double &lots[], double &fl[], int maxN)
+{
+   for(int z = 0; z < maxN; z++) { syms[z] = ""; cnt[z] = 0; lots[z] = 0; fl[z] = 0; }
+   int n = 0;
+   for(int i = 0; i < OrdersTotal() && n < maxN; i++)
+   {
+      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
+      if(OrderType() > OP_SELL) continue;               // positions only, no pending
+      string s = OrderSymbol();
+      int k = -1;
+      for(int j = 0; j < n; j++) if(syms[j] == s) { k = j; break; }
+      if(k < 0) { k = n; n++; syms[k] = s; }
+      cnt[k]++; lots[k] += OrderLots();
+      fl[k] += OrderProfit() + OrderSwap() + OrderCommission();
+   }
+   for(int a = 1; a < n; a++)                           // insertion sort
+   {
+      string sA = syms[a]; int cA = cnt[a]; double lA = lots[a]; double fA = fl[a];
+      int b2 = a - 1;
+      while(b2 >= 0 && (fl[b2] > fA || (fl[b2] == fA && cnt[b2] < cA)))
+      {
+         syms[b2+1] = syms[b2]; cnt[b2+1] = cnt[b2]; lots[b2+1] = lots[b2]; fl[b2+1] = fl[b2];
+         b2--;
+      }
+      syms[b2+1] = sA; cnt[b2+1] = cA; lots[b2+1] = lA; fl[b2+1] = fA;
+   }
+   return(n);
+}
+
+//--- count open positions matching a BINGO mode (live rescan)
+int BINGO_CountMatch(int mode, string sym)
+{
+   int n = 0;
+   for(int p = OrdersTotal()-1; p >= 0; p--)
+   {
+      if(!OrderSelect(p, SELECT_BY_POS, MODE_TRADES)) continue;
+      if(OrderType() > OP_SELL) continue;
+      if(mode != 5 && OrderSymbol() != sym) continue;
+      if(mode == 0 && OrderType() != OP_BUY) continue;
+      if(mode == 1 && OrderType() != OP_SELL) continue;
+      double pf = OrderProfit() + OrderSwap() + OrderCommission();
+      if(mode == 2 && pf <= 0) continue;                // WIN = floating profit
+      if(mode == 3 && pf >= 0) continue;                // LOSE = floating loss
+      n++;
+   }
+   return(n);
+}
+
+//--- the board: header row (ARM + pager), symbol rows, LAST + [CLOSE 全倉]
+void BINGO_Render(int x, int y, int w, int scale)
+{
+   int perPage = BINGO_RowsPerPage(y);
+   g_bingoPerPg = perPage;
+   string syms[28]; int cnt[28]; double lots[28]; double fl[28];
+   int n = BINGO_Collect(syms, cnt, lots, fl, 28);
+   int pages = (n + perPage - 1) / perPage;
+   if(pages < 1) pages = 1;
+   if(g_bingoPage >= pages) g_bingoPage = pages - 1;
+   if(g_bingoPage < 0) g_bingoPage = 0;
+   int row0 = g_bingoPage * perPage;
+
+   UpdRect("BGBOARD", x, y, w, 18*scale + perPage*15 + 18*scale + 10*scale, C'16,21,46', C'150,60,30');
+   UpdTxtBold("BGH", "CLOSE BOARD", x + 6, y + 3*scale, clrOrange, 10*scale);
+   string armTxt = g_bingoArmed ? StringFormat("ARM %ds", 60 - (int)(TimeCurrent() - g_bingoArmT)) : "ARM";
+   UpdBtn("BGA", armTxt, x + 120*scale, y + 2*scale, 64*scale, 14*scale, g_bingoArmed);
+   if(g_bingoArmed) ObjectSetInteger(0, PFX+"BGA", OBJPROP_BGCOLOR, clrOrange);
+   UpdTxt("BGP", StringFormat("%d/%d", g_bingoPage + 1, pages), x + w - 96*scale, y + 4*scale, clrWhite, 9*scale);
+   UpdBtn("BGP_L", "[<]", x + w - 64*scale, y + 2*scale, 28*scale, 13*scale, (g_bingoPage > 0));
+   UpdBtn("BGP_R", "[>]", x + w - 32*scale, y + 2*scale, 28*scale, 13*scale, (g_bingoPage < pages - 1));
+
+   double bal = DDG_Base();
+   for(int i = 0; i < perPage; i++)
+   {
+      int idx = row0 + i;
+      int ry  = y + 18*scale + i*15;
+      if(idx >= n) break;
+      color flC = (fl[idx] < 0) ? clrTomato : clrLime;
+      UpdTxt("BGR_"+IntegerToString(i), syms[idx], x, ry, clrWhite, 9*scale);
+      UpdTxt("BGN_"+IntegerToString(i), StringFormat("%d張", cnt[idx]), x + 74*scale, ry, clrWhite, 9*scale);
+      UpdTxt("BGF_"+IntegerToString(i), StringFormat("%+.2f", fl[idx]), x + 116*scale, ry, flC, 9*scale);
+      bool resid = (syms[idx] == g_bingoResidSym && g_bingoResidN > 0 && TimeCurrent() - g_bingoResidT < 60);
+      if(resid)
+         UpdTxt("BGD_"+IntegerToString(i), StringFormat("RESID %d", g_bingoResidN), x + 186*scale, ry, clrRed, 9*scale);
+      else
+      {
+         double pctP = (bal > 0) ? MathAbs(fl[idx]) / bal * 100.0 : 0;
+         UpdTxt("BGD_"+IntegerToString(i), StringFormat("%.1f%%", pctP), x + 186*scale, ry, (fl[idx] < 0) ? clrOrange : clrKhaki, 9*scale);
+      }
+      for(int b = 0; b < 5; b++)
+      {
+         bool cool = (TimeCurrent() - g_bingoCool[i][b] < 30);
+         string bl = BINGO_BtnName(b);
+         if(cool) bl = StringFormat("%ds", 30 - (int)(TimeCurrent() - g_bingoCool[i][b]));
+         string onm = PFX+"BGB_"+IntegerToString(i)+"_"+IntegerToString(b);
+         UpdBtn("BGB_"+IntegerToString(i)+"_"+IntegerToString(b), bl, x + 236*scale + b*50*scale, ry - 1, 46*scale, 13*scale, (g_bingoArmed && !cool));
+         if(g_bingoArmed && !cool)
+         {
+            ObjectSetInteger(0, onm, OBJPROP_BGCOLOR, clrOrangeRed);   // 橙紅、即按即執行
+            ObjectSetInteger(0, onm, OBJPROP_COLOR, clrWhite);
+         }
+      }
+   }
+   int ly = y + 18*scale + perPage*15 + 3*scale;
+   UpdTxt("BGL", (g_bingoLast == "" ? "LAST: -" : g_bingoLast), x, ly, clrKhaki, 9*scale);
+   bool allOn = (g_bingoArmed && TimeCurrent() - g_bingoCoolAll >= 30);
+   UpdBtn("BGC", "[ CLOSE 全倉 ]", x + w - 122*scale, ly - 2*scale, 118*scale, 16*scale, allOn);
+   if(allOn)
+   {
+      ObjectSetInteger(0, PFX+"BGC", OBJPROP_BGCOLOR, clrOrangeRed);
+      ObjectSetInteger(0, PFX+"BGC", OBJPROP_COLOR, clrWhite);
+   }
+}
