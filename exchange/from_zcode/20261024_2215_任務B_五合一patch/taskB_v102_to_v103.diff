+// === Alias table: canonical want -> broker-side base name (before normalize) ===
+#define ALIAS_N 1
+string ALIAS_FROM[ALIAS_N] = { "US500" };   // F1B broker 實名 SP500.r
+string ALIAS_TO[ALIAS_N]   = { "SP500" };
