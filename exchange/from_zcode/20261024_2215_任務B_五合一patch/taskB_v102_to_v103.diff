-int totalSymbols = 30;
+int totalSymbols = 0;
+string resolvedSymbols[];      // want-indexed cache; "" = unresolvable
+int    missingSymbols = 0;
+string missingList = "";
+
+//+------------------------------------------------------------------+
+string NormalizeSym(string s)
+{
+    // strip trailing dots: "XAUUSD." -> "XAUUSD"
+    while(StringLen(s) > 0 &&
+          StringGetCharacter(s, StringLen(s) - 1) == '.')
+        s = StringSubstr(s, 0, StringLen(s) - 1);
+    // strip common broker suffixes: "SP500.r" -> "SP500"
+    string suffixes[3] = {".RAW", ".R", ".M"};
+    for(int k = 0; k < 3; k++)
+    {
+        int pos = StringFind(s, suffixes[k]);
+        if(pos > 0)
+            s = StringSubstr(s, 0, pos);
+    }
+    return s;
+}
+
+//+------------------------------------------------------------------+
+//| FIX-1: exact name -> alias -> normalized enumeration match       |
+//+------------------------------------------------------------------+
+string ResolveSym(const string want)
+{
+    // 1) exact broker name already exists
+    if(MarketInfo(want, MODE_POINT) > 0)
+        return want;
+
+    // 2) alias mapping (e.g. US500 -> SP500)
+    string w = want;
+    for(int a = 0; a < ALIAS_N; a++)
+    {
+        if(StringCompare(want, ALIAS_FROM[a], false) == 0)
+        {
+            w = ALIAS_TO[a];
+            break;
+        }
+    }
+    if(w != want && MarketInfo(w, MODE_POINT) > 0)
+        return w;
+
+    // 3) normalized enumeration match over the full broker symbol table
+    string wu = NormalizeSym(w);
+    StringToUpper(wu);
+    int total = SymbolsTotal(false);
+    for(int i = 0; i < total; i++)
+    {
+        string s  = SymbolName(i, false);
+        string su = s;
+        StringToUpper(su);
+        su = NormalizeSym(su);
+        if(su == wu && MarketInfo(s, MODE_POINT) > 0)
+            return s;
+    }
+    return "";
+}
+
+//+------------------------------------------------------------------+
+//| FIX-2: one-shot resolution pass at init; missing = stop, no fill |
+//+------------------------------------------------------------------+
+void ResolutionPass()
+{
+    ArrayResize(resolvedSymbols, totalSymbols);
+    missingSymbols = 0;
+    missingList = "";
+    for(int s = 0; s < totalSymbols; s++)
+    {
+        resolvedSymbols[s] = ResolveSym(Symbols[s]);
+        if(resolvedSymbols[s] == "")
+        {
+            missingSymbols++;
+            missingList = missingList + Symbols[s] + " ";
+            Print("MISSING: want=", Symbols[s],
+                  " no broker match after alias+normalize (rows will be skipped, NOT filled)");
+        }
+        else
+        {
+            Print("RESOLVED: want=", Symbols[s], " -> ", resolvedSymbols[s]);
+        }
+    }
+}
 
