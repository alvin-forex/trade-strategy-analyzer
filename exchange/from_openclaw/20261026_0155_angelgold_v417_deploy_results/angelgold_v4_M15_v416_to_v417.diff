+      if(wins <= 1) break;                       // 淨返主圖，收工
+      bool deletedThisRound = false;
+      for(int w = wins - 1; w >= 1; w--)         // 由高窗刪起
+      {
+         int total = ChartIndicatorsTotal(0, w);
+         for(int k = total - 1; k >= 0; k--)     // 子窗內由尾刪起
